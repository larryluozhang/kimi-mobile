<?xml version="1.0" encoding="utf-8"?>
<!-- 启动门控页：窗口背景即品牌渐变 splash，根布局透明 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="连接你的 Kimi Code 服务端"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/gateProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:indeterminateTint="@android:color/white" />

    <TextView
        android:id="@+id/gateStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="正在连接服务器…"
        android:textColor="@android:color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/gateHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="服务器在 Tailscale 内网中。请确认 Tailscale 已连接。\n建议在系统设置中为 Tailscale 开启「始终开启的 VPN」。"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnOpenTailscale"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="打开 Tailscale"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <!-- 始终可见：连不上时也能进设置改服务器/token，防止被门控页困死 -->
    <Button
        android:id="@+id/btnGateSettings"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="服务器设置"
        android:textColor="@android:color/white" />
</LinearLayout>
